rules_version = '2';

// Правила безопасности Firestore для MillionersBot.
// Доступ к данным семьи (households/{householdId}) — только авторизованным
// пользователям, состоящим в memberIDs этой семьи.
service cloud.firestore {
  match /databases/{database}/documents {

    // Публичная карта инвайт-кодов: код -> householdId.
    // Не содержит приватных данных, поэтому читать может любой вошедший
    // (зная сам код). Это позволяет вступить в семью, не открывая её данные.
    match /inviteCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['householdId', 'createdAt']);
      allow update, delete: if false;
    }

    match /households/{householdId} {

      // Кто состоит в семье.
      function isMember() {
        return request.auth != null
          && request.auth.uid in resource.data.memberIDs;
      }

      // Создание семьи: пользователь авторизован и кладёт себя в memberIDs.
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.memberIDs;

      // Чтение документа семьи — участникам.
      allow read: if isMember();

      // Обновление: либо уже участник, либо вступаешь по коду
      // (добавляешь только себя в memberIDs, остальные поля не меняешь).
      allow update: if isMember()
        || (request.auth != null
            && request.resource.data.memberIDs.hasAll(resource.data.memberIDs)
            && request.resource.data.memberIDs.removeAll(resource.data.memberIDs) == [request.auth.uid]
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIDs']));

      allow delete: if false;

      // Вложенные коллекции (expenses, categories, savings) — только участникам семьи.
      match /{collection}/{docId} {
        function parentMembers() {
          return get(/databases/$(database)/documents/households/$(householdId)).data.memberIDs;
        }
        allow read, write: if request.auth != null
          && request.auth.uid in parentMembers();
      }
    }
  }
}
